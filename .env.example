# Leave blank to select Devin, OpenAI, Anthropic, then mock based on available credentials.
VISION_PROVIDER=

# Optional vision provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Devin session integration. Leave unset to use the simulated session.
DEVIN_API_KEY=
TARGET_REPO=woodstock-thebrid/video2pr
DEVIN_ORG_ID=org-8df7501a85724235b32b5e64a28da839

# Set MOCK_DEVIN=1 to force the simulated session even with a Devin API key.
MOCK_DEVIN=0
# Optional local tuning for mock runs.
MOCK_DEVIN_SECONDS=40
DEVIN_POLL_SECONDS=10

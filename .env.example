# Optional vision provider credentials. OpenAI takes precedence when both are set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Devin session integration. Leave unset to use the simulated session.
DEVIN_API_KEY=
TARGET_REPO=woodstock-thebrid/video2pr

# Set MOCK_DEVIN=1 to force the simulated session even with a Devin API key.
MOCK_DEVIN=0
# Optional local tuning for mock runs.
MOCK_DEVIN_SECONDS=40
DEVIN_POLL_SECONDS=10
